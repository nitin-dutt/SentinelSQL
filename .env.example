# =====================================================================
# Database Configuration
# =====================================================================
# Point SentinelSQL at your database with ONE setting. The SQL dialect is detected from the URL, and
# `postgres://`, `postgresql://`, `mysql://` and `mariadb://` are mapped to the drivers in requirements.txt.
#
#   PostgreSQL: DATABASE_URL="postgresql://user:password@host:5432/dbname"
#   MySQL:      DATABASE_URL="mysql://user:password@host:3306/dbname"
#   SQLite:     DATABASE_URL="sqlite:///sentinel.db"        (the bundled demo; the default)
#
# Leave ACTIVE_DB unset. It is a legacy switch between the three DATABASE_URL_* variables further down, and if it is set it takes
# precedence over DATABASE_URL.
DATABASE_URL="sqlite:///sentinel.db"

# Only the default schema is exposed to the model (PostgreSQL: public, or the schema in your search_path; MySQL: the database in
# the URL). Only tables are listed, not views. Seeding the demo tables into a PostgreSQL/MySQL database is opt-in: SEED_DEMO_DATA=true.

# Recommended for production: a database user that can only SELECT. Without it SentinelSQL falls back to a READ ONLY session on
# the primary connection (verified, but a dedicated user is the stronger guarantee) and logs a warning.
# READONLY_DATABASE_URL="postgresql://sentinel_ro:password@host:5432/dbname"
#
#   PostgreSQL:  CREATE USER sentinel_ro WITH PASSWORD '...';
#                GRANT CONNECT ON DATABASE dbname TO sentinel_ro;
#                GRANT USAGE ON SCHEMA public TO sentinel_ro;
#                GRANT SELECT ON ALL TABLES IN SCHEMA public TO sentinel_ro;
#   MySQL:       CREATE USER 'sentinel_ro'@'%' IDENTIFIED BY '...';
#                GRANT SELECT ON dbname.* TO 'sentinel_ro'@'%';

# Try it with Docker (throwaway servers):
#   docker run -d --name sentinel-pg    -e POSTGRES_USER=user -e POSTGRES_PASSWORD=password -e POSTGRES_DB=dbname -p 5432:5432 postgres:16
#   docker run -d --name sentinel-mysql -e MYSQL_ROOT_PASSWORD=password -e MYSQL_DATABASE=dbname -p 3307:3306 mysql:8
#   then:  DATABASE_URL="postgresql://user:password@localhost:5432/dbname"   or   DATABASE_URL="mysql://root:password@localhost:3307/dbname"
#          SEED_DEMO_DATA=true        (creates the 21-table demo company in an empty database)

# Legacy per-engine variables (used only when ACTIVE_DB is set to "sqlite", "postgres" or "mysql")
# ACTIVE_DB="sqlite"
# DATABASE_URL_SQLITE="sqlite:///sentinel.db"
# DATABASE_URL_POSTGRES="postgresql+psycopg2://user:password@localhost:5432/dbname"
# DATABASE_URL_MYSQL="mysql+mysqlconnector://user:password@localhost:3307/dbname"

# =====================================================================
# Audit Trail Configuration (SOC 2 Compliance)
# =====================================================================
# SQLite database path for immutable query audit logs
AUDIT_DB_PATH="audit.db"

# =====================================================================
# LLM Provider Configuration
# =====================================================================
# Provider selection: "gemini" or "ollama" (defaults to "gemini" if GEMINI_API_KEY is present)
LLM_PROVIDER="gemini"

# Option 1: Google Gemini (Recommended for Evaluators / Zero-GPU Setup)
# Free API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Option 2: Local Ollama (Air-Gapped / Offline Setup)
# Requires local Ollama instance running: ollama run qwen2.5:14b-instruct
INTENT_MODEL="qwen2.5:14b-instruct"
SQL_MODEL="deepseek-coder:6.7b"
VALIDATION_MODEL="qwen2.5:14b-instruct"

# =====================================================================
# Query Governance & Execution Limits
# =====================================================================
# LIMIT injected into any query that has none (the query then still auto-executes). 1000 = the ceiling below;
# the default was 100 until the Spider benchmark measured the cost of the lower cap (5 points). An answer that
# reaches the injected limit is marked "truncated": true with "row_limit", and the UI says so.
MAX_ROWS=1000

# Hard ceiling on rows: explicit LIMITs above this are capped and sent for review, and
# no query ever returns more than this many rows (results get "truncated": true)
MAX_RESULT_ROWS=1000

# Statement timeout in seconds: a query that runs longer is cancelled (SQLite, PostgreSQL, MySQL)
QUERY_TIMEOUT=10

# Intent-stage routing (app/agents/router.py). "llm" (default, measured best on Spider) sends every question through the
# intent model call. "direct" skips it; "auto" skips it unless the question mentions something sensitive; "decision" and
# "decision_keywords" ask Gemini Decision 1 (on the free tier Google may use the questions, so keep them off for real data).
# The command filter and the policy engine run in every mode.
INTENT_MODE="llm"

# Execution-guided candidate voting (app/agents/candidate_voting.py). 1 = off. With 2-5 the generator writes that many
# candidate queries, the policy screens each, the allowed ones run read-only and the most agreed-on result wins.
# Costs that many model calls per question.
SQL_CANDIDATES=1

# Confidence & Validation Engine: "ast" (Deterministic AST Rules - Recommended) or "llm" (Experimental:
# app/experimental_llm_grading.py lets a model re-grade queries the policy allowed; planned for removal)
VALIDATION_MODE="ast"

# =====================================================================
# Semantic Query Cache Configuration
# =====================================================================
# Enable sub-10ms semantic vector caching for natural language queries
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity threshold for cache hits (0.0 to 1.0)
SEMANTIC_CACHE_THRESHOLD=0.92
# Cache entry time-to-live in seconds (3600 = 1 hour)
SEMANTIC_CACHE_TTL_SECONDS=3600
# Maximum cache capacity before LRU eviction
SEMANTIC_CACHE_MAX_ENTRIES=500


# =====================================================================
# Authentication & Access Control
# =====================================================================
# Every API route requires `Authorization: Bearer <token>`. Generate tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Format: token:user_id:role,token:user_id:role
# Roles: employee (ask questions) | admin (review queue + admin APIs) | external_ai (MCP clients)
# With no valid tokens configured, every protected route returns 401.
AUTH_TOKENS="REPLACE_ME_1:alice:employee,REPLACE_ME_2:admin-1:admin,REPLACE_ME_3:admin-2:admin,REPLACE_ME_4:claude-desktop:external_ai"
# By default an admin cannot approve a query they submitted themselves.
HITL_ALLOW_SELF_APPROVAL=false
# Identity recorded for the local stdio MCP transport (no HTTP token there)
# MCP_CLIENT_ID="mcp-stdio"
# Sensitive-table policy file (default: app/policy/sensitivity.json)
# SENSITIVITY_CONFIG=""

# =====================================================================
# Demo data, persistence & reliability
# =====================================================================
# Seed the bundled demo database (21 tables) at startup. Default: true for SQLite, false for
# PostgreSQL/MySQL, so pointing SentinelSQL at a real database never writes demo tables into it.
# SEED_DEMO_DATA=true
# If the configured PostgreSQL/MySQL server is unreachable, silently use the local demo SQLite file.
# Off by default: it would hide an outage and point the app at the wrong data.
# DB_FALLBACK_TO_SQLITE=false

# Pending Human-in-the-Loop approvals are stored here and survive restarts
HITL_DB_PATH="hitl_runs.db"
# Hours a request may wait for review before it expires / hours finished runs are kept
HITL_PENDING_TTL_HOURS=72
HITL_FINISHED_TTL_HOURS=24

# Language-model calls: per-request timeout and retries (exponential backoff) on rate limits / 5xx
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Application log level (output goes to stderr): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =====================================================================
# Observability (app/observability/tracing.py)
# =====================================================================
# Every request is recorded as a trace with one span per stage (cache, retrieval, router, intent, generation, gate,
# execution, repair) and one record per model call (latency, tokens, cost). Shown under Observability in the admin UI.
# TRACING_ENABLED=true
# TRACE_DB_PATH="traces.db"
# Oldest traces are deleted beyond this many
# TRACE_MAX_ROWS=5000
# Prices in US dollars per million tokens. Leave unset and cost is reported as unknown, never guessed.
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# Per-model prices override the two values above: {"model-name": {"input": 0.10, "output": 0.40}}
# LLM_PRICES_JSON=

# =====================================================================
# Analyst chat (POST /chat; app/agents/analyst.py)
# =====================================================================
# Conversations are kept so follow-ups ("now by region") can be rewritten into a full question. Result rows are never stored.
# CONVERSATION_DB_PATH="conversations.db"
# CONVERSATION_TTL_HOURS=24
# Let the planner ask ONE clarifying question when a request is ambiguous
# ANALYST_CLARIFY=true
# Let the agent look at the database with tools before writing SQL (list tables, describe a table, sample values,
# search the glossary). Off by default: it adds model calls and its effect on accuracy is not measured yet.
# ANALYST_EXPLORE=false
# ANALYST_MAX_STEPS=4

# Embeddings: auto (default) | gemini | ollama | offline (deterministic hash vectors, no network)
# EMBEDDING_PROVIDER=auto
# Vector size requested from Gemini (its default is 3072; 768 is 4x smaller to store and scan)
# GEMINI_EMBEDDING_DIM=768
# Never fall back to offline vectors when the provider fails: raise instead (fail closed)
# EMBEDDING_STRICT=false

# =====================================================================
# Public demo (hosted so that anyone with the link can try it)
# =====================================================================
# DEMO_MODE=true turns on the limits below and shows one-click logins on the sign-in page. Everything is off by default.
# DEMO_MODE=true
# Users from AUTH_TOKENS whose tokens are shown to visitors. Name only throwaway demo users here, never your own admin:
#   AUTH_TOKENS="<random>:demo-employee:employee,<random>:demo-reviewer:admin,<your secret>:owner:admin"
# DEMO_PUBLIC_USERS="demo-employee,demo-reviewer"
# Questions per visitor per minute, and per UTC day that need the language model (cached answers are free and never refused)
# DEMO_RATE_PER_MINUTE=6
# DEMO_DAILY_QUERY_CAP=150
# Behind a proxy or load balancer (Render, Fly, ...): count visitors by the first X-Forwarded-For address
# DEMO_TRUST_PROXY=true
# Text shown above the demo logins
# DEMO_NOTICE="Public demo on a small sample company database."
# In demo mode, write requests to /admin/* (clearing the audit log or cache, editing the glossary) are refused, and questions
# are limited to 300 characters. Counters are kept in memory, so a restart resets them.

# =====================================================================
# Launch page: entering without a token, and visitors' own databases (app/workspaces.py)
# =====================================================================
# APP_ENV="dev" removes the access-token step: the launch page lets anyone enter the sample database as an employee,
# a reviewer or an agent. For local development and testing only. Leave it unset (or any other value) everywhere else.
# APP_ENV="dev"
# Let visitors connect their own PostgreSQL/MySQL database from the launch page. Each gets a private workspace (its own
# connection, review queue, audit log and cache) that lives in memory and is deleted when idle. Unset: on in dev and in demo mode.
# WORKSPACES_ENABLED=true
# Questions one workspace may ask, minutes it may sit idle before it is closed, and how many may exist at once
# WORKSPACE_QUESTION_QUOTA=25
# WORKSPACE_TTL_MINUTES=120
# WORKSPACE_MAX_ACTIVE=20
# Databases with more tables than this are refused
# WORKSPACE_MAX_TABLES=300
# Folder for workspace files (deleted with the workspace, and at startup)
# WORKSPACE_DIR="workspaces"
# May a visitor's URL point at localhost or a private network? Unset: only when APP_ENV=dev. Never turn it on for a public host.
# WORKSPACE_ALLOW_PRIVATE_HOSTS=false

# =====================================================================
# Less common settings (every one has a working default)
# =====================================================================
# All settings are read in app/settings.py; that file and this one list the same variables (a test checks it).
# GOOGLE_API_KEY is accepted as another name for GEMINI_API_KEY
# GOOGLE_API_KEY=""
# Times the SQL is sent back to the model after the database rejects it (0 switches the repair step off)
# SQL_REPAIR_ATTEMPTS=1
# Verified example queries put into the SQL prompt (0 switches them off)
# FEWSHOT_TOP_K=2
# Vectors the embedding engine keeps in memory; the least recently used are dropped when it is full
# EMBEDDING_CACHE_SIZE=2048
# Seconds to leave a failing embedding provider alone before trying it again
# EMBEDDING_RETRY_SECONDS=30
# Seconds between writes of the semantic cache file
# SEMANTIC_CACHE_SAVE_INTERVAL_SECONDS=2
# Seconds between checks of whether the database content changed (cached answers are dropped when it did)
# DATA_VERSION_CHECK_SECONDS=1
# Files for the business glossary and the verified example queries, and for their vectors.
# By default the two tables live in the SQLite demo database, or in sentinel_app.db when you use PostgreSQL/MySQL.
# DICTIONARY_DB_PATH="sentinel_app.db"
# GOLDEN_DB_PATH="sentinel_app.db"
# DICTIONARY_VECTOR_CACHE=".dictionary_vectors.json"
# GOLDEN_VECTOR_CACHE=".golden_vectors.json"
# Plain-language table descriptions used when indexing the schema (default: app/db/table_descriptions.json)
# TABLE_DESCRIPTIONS_PATH="app/db/table_descriptions.json"
# Folder with the built frontend to serve from the API (the Docker image sets it; leave unset in development)
# UI_DIST_DIR="sentinel-frontend/dist"
