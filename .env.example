# =====================================================================
# Database Configuration
# =====================================================================
# Select which database SentinelSQL connects to: "sqlite", "postgres", or "mysql"
# Defaults to "sqlite" if unset.
ACTIVE_DB="sqlite"

# SQLite (Local file, zero Docker required)
DATABASE_URL_SQLITE="sqlite:///sentinel.db"

# PostgreSQL (Docker container on port 5432)
# docker run --name sentinel-postgres -e POSTGRES_USER=user -e POSTGRES_PASSWORD=password -e POSTGRES_DB=database_name -p 5432:5432 -d postgres:16
DATABASE_URL_POSTGRES="postgresql+psycopg2://user:password@localhost:5432/database_name"

# MySQL (Docker container on port 3307)
# docker run --name sentinel-mysql -e MYSQL_ROOT_PASSWORD=password -e MYSQL_DATABASE=database_name -p 3307:3306 -d mysql:8
DATABASE_URL_MYSQL="mysql+mysqlconnector://user:password@localhost:3307/database_name"

# Optional: Dedicated Read-Only Connection URL (Defaults to primary connection or sqlite read-only URI)
# READONLY_DATABASE_URL=""

# =====================================================================
# Audit Trail Configuration (SOC 2 Compliance)
# =====================================================================
# SQLite database path for immutable query audit logs
AUDIT_DB_PATH="audit.db"

# =====================================================================
# LLM Provider Configuration
# =====================================================================
# Provider selection: "gemini" or "ollama" (defaults to "gemini" if GEMINI_API_KEY is present)
LLM_PROVIDER="gemini"

# Option 1: Google Gemini (Recommended for Evaluators / Zero-GPU Setup)
# Free API key from https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Option 2: Local Ollama (Air-Gapped / Offline Setup)
# Requires local Ollama instance running: ollama run qwen2.5:14b-instruct
INTENT_MODEL="qwen2.5:14b-instruct"
SQL_MODEL="deepseek-coder:6.7b"
VALIDATION_MODEL="qwen2.5:14b-instruct"
EXPLANATION_MODEL="qwen2.5:14b-instruct"

# =====================================================================
# Query Governance & Execution Limits
# =====================================================================
# LIMIT injected into any query that has none (the query then still auto-executes)
MAX_ROWS=100

# Hard ceiling on rows: explicit LIMITs above this are capped and sent for review, and
# no query ever returns more than this many rows (results get "truncated": true)
MAX_RESULT_ROWS=1000

# Statement timeout in seconds: a query that runs longer is cancelled (SQLite, PostgreSQL, MySQL)
QUERY_TIMEOUT=10

# Confidence & Validation Engine: "ast" (Deterministic AST Rules - Recommended) or "llm" (Experimental)
VALIDATION_MODE="ast"

# =====================================================================
# Semantic Query Cache Configuration
# =====================================================================
# Enable sub-10ms semantic vector caching for natural language queries
SEMANTIC_CACHE_ENABLED=true
# Cosine similarity threshold for cache hits (0.0 to 1.0)
SEMANTIC_CACHE_THRESHOLD=0.92
# Cache entry time-to-live in seconds (3600 = 1 hour)
SEMANTIC_CACHE_TTL_SECONDS=3600
# Maximum cache capacity before LRU eviction
SEMANTIC_CACHE_MAX_ENTRIES=500


# =====================================================================
# Authentication & Access Control
# =====================================================================
# Every API route requires `Authorization: Bearer <token>`. Generate tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Format: token:user_id:role,token:user_id:role
# Roles: employee (ask questions) | admin (review queue + admin APIs) | external_ai (MCP clients)
# With no valid tokens configured, every protected route returns 401.
AUTH_TOKENS="REPLACE_ME_1:alice:employee,REPLACE_ME_2:admin-1:admin,REPLACE_ME_3:admin-2:admin,REPLACE_ME_4:claude-desktop:external_ai"
# By default an admin cannot approve a query they submitted themselves.
HITL_ALLOW_SELF_APPROVAL=false
# Identity recorded for the local stdio MCP transport (no HTTP token there)
# MCP_CLIENT_ID="mcp-stdio"
# Sensitive-table policy file (default: app/policy/sensitivity.json)
# SENSITIVITY_CONFIG=""

# =====================================================================
# Demo data, persistence & reliability
# =====================================================================
# Seed the bundled demo database (21 tables) at startup. Default: true for SQLite, false for
# PostgreSQL/MySQL, so pointing SentinelSQL at a real database never writes demo tables into it.
# SEED_DEMO_DATA=true
# If the configured PostgreSQL/MySQL server is unreachable, silently use the local demo SQLite file.
# Off by default: it would hide an outage and point the app at the wrong data.
# DB_FALLBACK_TO_SQLITE=false

# Pending Human-in-the-Loop approvals are stored here and survive restarts
HITL_DB_PATH="hitl_runs.db"
# Hours a request may wait for review before it expires / hours finished runs are kept
HITL_PENDING_TTL_HOURS=72
HITL_FINISHED_TTL_HOURS=24

# Language-model calls: per-request timeout and retries (exponential backoff) on rate limits / 5xx
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Application log level (output goes to stderr): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Embeddings: auto (default) | gemini | ollama | offline (deterministic hash vectors, no network)
# EMBEDDING_PROVIDER=auto
# Vector size requested from Gemini (its default is 3072; 768 is 4x smaller to store and scan)
# GEMINI_EMBEDDING_DIM=768
# Never fall back to offline vectors when the provider fails: raise instead (fail closed)
# EMBEDDING_STRICT=false
